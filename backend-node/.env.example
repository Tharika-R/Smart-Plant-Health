# Plantora Node.js Express Backend Environment Configuration

# 1. Google Gemini API Key (ONLY AI Provider - Keep Secret)
GEMINI_API_KEY=your_api_key_here

# 2. PostgreSQL Prisma Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plantora_db?schema=public

# 3. Security & Authentication
JWT_SECRET=super_secret_jwt_key_plantora_2026

# 4. Server Networking
PORT=5000
FRONTEND_URL=http://localhost:5173
